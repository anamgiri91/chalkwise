  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "npm run typecheck && npm run format:check",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix server",
    "test": "node --test tests/*.test.ts && npm test --prefix server && npm run test:legacy",
    "test:legacy": "node supabase/functions/analyze-material/check.cjs && node supabase/functions/ask-lecture/check.cjs && node supabase/functions/generate-quiz/check.cjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "check": "npm run typecheck && npm test && npm run format:check",
    "build:web": "expo export --platform web",
    "api": "npm start --prefix server"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  }
