NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Use a runtime login granted classlens_app, never the schema owner.
DATABASE_URL=postgresql://classlens_runtime:replace-me@localhost:5432/classlens
# Required in production; download AWS RDS's CA bundle separately.
DATABASE_CA_FILE=
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_REPLACE
COGNITO_CLIENT_ID=replace-me
S3_BUCKET=classlens-private-materials
WEB_ORIGINS=http://localhost:8081
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
