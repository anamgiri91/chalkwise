# Choose mock, api or legacy supabase. Missing DATA_MODE defaults to mock.
# Copy to .env.local and restart Expo after changing the mode.
EXPO_PUBLIC_DATA_MODE=mock
# Switch to api after provisioning and testing the new backend.
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Legacy adapter only:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
